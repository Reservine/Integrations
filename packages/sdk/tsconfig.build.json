{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "types": ["node", "svelte", "vite/client"]
  },
  "include": [
    "src/contract.ts",
    "src/browser.ts",
    "src/build-env.d.ts",
    "src/element.ts",
    "src/index.ts",
    "src/adapters/react.tsx",
    "src/adapters/vue.ts",
    "src/adapters/angular.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
